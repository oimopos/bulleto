# HTTP-панель
HOST=0.0.0.0
PORT=8787

# SQLite. В Docker путь уже переопределён на /app/data/buleto.sqlite.
DATABASE_PATH=./data/buleto.sqlite
# Необязательный согласованный snapshot: копируется только если DATABASE_PATH ещё не существует.
# DATABASE_SEED_PATH=./seed/buleto.sqlite

# Публичный поток результатов Buleto. Логин и пароль не нужны.
BULETO_WS_URL=wss://buleto.com/ws
BULETO_INSTRUMENT=XPM/RUB
COLLECTOR_ENABLED=true

# Только виртуальный банк симуляции. Реальные деньги и баланс Buleto не используются.
# 87 700 покрывает 216 виртуальных промахов и следующую ставку №217.
VIRTUAL_STARTING_BALANCE=87700

# Если между известными результатами больше этого интервала,
# цикл помечается как неполный из-за возможного пропуска.
GAP_THRESHOLD_SECONDS=135

# Повторное подключение и контроль зависшего соединения.
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000
STALE_AFTER_MS=180000
